# ThingsBoard monolith on external PostgreSQL. Secrets (datasource user/password, JAVA_OPTS) come from compose/.env.
TB_SERVICE_TYPE=monolith
TB_QUEUE_TYPE=in-memory
JS_EVALUATOR=local
DATABASE_TS_TYPE=sql
SPRING_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/thingsboard
# Transports: MQTT + HTTP only. CoAP/LwM2M/SNMP off (D12 scope; saves memory).
MQTT_ENABLED=true
COAP_ENABLED=false
LWM2M_ENABLED=false
SNMP_ENABLED=false
DEVICE_CONNECTIVITY_COAP_ENABLED=false
# Metrics for Prometheus (scraped at /actuator/prometheus).
METRICS_ENABLED=true
METRICS_ENDPOINTS_EXPOSE=prometheus
HTTP_LOG_CONTROLLER_ERROR_STACK_TRACE=false
