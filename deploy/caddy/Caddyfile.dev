# Local dev routing (plain HTTP on *.localhost). Production vhosts live in Caddyfile.prod (M2.2).
{
	admin 0.0.0.0:2019
	metrics
	auto_https off
}

http://localhost {
	handle_path /docs/* {
		reverse_proxy docs:80
	}
	reverse_proxy portal:8000
}
http://app.localhost {
	reverse_proxy tb:8080
}
http://auth.localhost {
	reverse_proxy keycloak:8080
}
http://grafana.localhost {
	reverse_proxy grafana:3000
}
http://status.localhost {
	reverse_proxy uptime-kuma:3001
}
http://prometheus.localhost {
	reverse_proxy prometheus:9090
}

http://flows.localhost {
	@editor path_regexp user ^/u/([0-9a-f-]+)(/.*)?$
	handle @editor {
		forward_auth portal:8000 {
			uri /flows/auth
			copy_headers X-Flows-User
		}
		reverse_proxy nodered-{re.user.1}:1880
	}
	redir / http://localhost/flows 302
}

http://lab.localhost {
	reverse_proxy jupyterhub:8000
}
