# Production/staging routing. Activated in M2.2. {$DOMAIN} from .env. Requires the layer4 build (make caddy-image).
{
	admin 0.0.0.0:2019
	metrics
	email ops@{$DOMAIN}
	layer4 {
		# MQTTS (D8): terminate TLS here, forward plaintext to TB's MQTT transport.
		:8883 {
			route {
				tls
				proxy tb:1883
			}
		}
	}
}

{$DOMAIN} {
	# /docs (no trailing slash) would fall through to the portal and 404 — redirect to /docs/.
	redir /docs /docs/ 308
	handle_path /docs/* {
		reverse_proxy docs:80
	}
	reverse_proxy portal:8000
}
app.{$DOMAIN} {
	# Token handoff (D13): the portal mints a project member's ThingsBoard session and sends them
	# here with the JWT in the URL fragment; this same-origin page stores it the way the TB SPA
	# expects and redirects into the console. The fragment never reaches the server or logs.
	handle /chert-login {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond `<!doctype html><meta charset="utf-8"><title>Opening ThingsBoard…</title><script>
try{var h=new URLSearchParams(location.hash.slice(1));var j=h.get("jwt"),r=h.get("refresh");
if(j){localStorage.setItem("jwt_token",j);if(r)localStorage.setItem("refresh_token",r);}}catch(e){}
location.replace("/");
</script>Opening ThingsBoard…` 200
	}
	handle {
		reverse_proxy tb:8080
	}
}
auth.{$DOMAIN} {
	reverse_proxy keycloak:8080
}
status.{$DOMAIN} {
	reverse_proxy uptime-kuma:3001
}
# Admin-only: add forward_auth / IP allowlist in M2.2.
grafana.{$DOMAIN} {
	reverse_proxy grafana:3000
}

flows.{$DOMAIN} {
	@editor path_regexp user ^/u/([0-9a-f-]+)(/.*)?$
	handle @editor {
		# Pass the path's owner id explicitly: WebSocket upgrade requests (Node-RED /comms)
		# reach forward_auth with an empty X-Forwarded-Uri, so the auth check must not rely on it.
		forward_auth portal:8000 {
			uri /flows/auth
			header_up X-Flows-Uid {re.user.1}
			# Strip upgrade semantics from the AUTH subrequest so /comms WebSocket upgrades
			# still get authenticated (otherwise Caddy can't make the subrequest → 403).
			header_up -Connection
			header_up -Upgrade
			copy_headers X-Flows-User
		}
		reverse_proxy nodered-{re.user.1}:1880
	}
	redir / https://{$DOMAIN}/flows 302
}

lab.{$DOMAIN} {
	reverse_proxy jupyterhub:8000
}

# LoRa: registration is a portal path (/lora); the subdomain only redirects there.
# ChirpStack's own UI is internal admin tooling and is not publicly exposed.
lora.{$DOMAIN} {
	redir / https://{$DOMAIN}/lora 302
	redir /* https://{$DOMAIN}/lora 302
}
