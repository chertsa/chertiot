# CHERT IoT — copy to .env and fill in. Never commit .env.
# ---- environment / routing ----
ENV=dev                          # dev | staging | prod
DOMAIN=localhost                 # chertiot.com in prod; staging.chertiot.com in staging
CADDYFILE=deploy/caddy/Caddyfile.dev   # deploy/caddy/Caddyfile.prod from M2.2
# ---- image pins (M0.2, 2026-08-30). Upgrades are deliberate milestones. ----
POSTGRES_VERSION=16.15
TB_VERSION=4.3.1.4
TB_IMAGE=ghcr.io/chertsa/chertiot-tb:4.3.1.4-b1   # branded build (images.yml); same image in every environment
KEYCLOAK_VERSION=26.7.2
CADDY_VERSION=2.11.4
CADDY_IMAGE=ghcr.io/chertsa/chertiot-caddy:2.11.4-l4   # published by CI (images.yml); same image in every environment
CADDY_L4_VERSION=42db5690dea1
PROMETHEUS_VERSION=v3.14.0
GRAFANA_VERSION=13.1.4
UPTIME_KUMA_VERSION=2.5.3
NODE_EXPORTER_VERSION=v1.12.1
CADVISOR_VERSION=v0.55.1
POSTGRES_EXPORTER_VERSION=v0.20.1
ALERTMANAGER_VERSION=v0.34.0
CHIRPSTACK_VERSION=4.19.1
CHIRPSTACK_REST_VERSION=4.19.0
CHIRPSTACK_GW_BRIDGE_VERSION=4.1.2
MOSQUITTO_VERSION=2.0.22
REDIS_VERSION=7.4.11
LORA_ENABLED=false
CHIRPSTACK_API_SECRET=change-me            # ChirpStack API JWT secret (generated on deploy)
NODERED_VERSION=5.0.6
SOCKET_PROXY_VERSION=v0.5.0
LAB_INTERNAL_SECRET=change-me            # portal↔jupyterhub in-network secret (generated on deploy)
LAB_ENABLED=false
FLOWS_ENABLED=false                     # true where the flows profile runs
MAILPIT_VERSION=v1.31.0                # dev only (docker-compose.override.yml)
# ---- postgres (superuser; owns databases thingsboard, keycloak, portal) ----
POSTGRES_USER=chertiot
POSTGRES_PASSWORD=change-me
# ---- thingsboard ----
TB_JAVA_OPTS="-Xms256m -Xmx1536m"
TB_SYSADMIN_EMAIL=sysadmin@thingsboard.org   # default; rotated by M0.4 bootstrap
TB_SYSADMIN_PASSWORD=sysadmin                # default; rotate before staging/prod (BACKLOG: automate)
# D4 quota overrides (defaults live in templates-tb/tenant-profile-student.json)
#TB_QUOTA_MAX_DEVICES=10
#TB_QUOTA_DEVICE_MSG_RATE=10:1,300:60
# ---- keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KC_HOSTNAME=http://auth.localhost            # https://auth.chertiot.com in prod
KC_REALM=chertiot
KC_INTERNAL_URL=http://keycloak:8080         # backchannel (token/userinfo) from TB/portal containers
TB_PUBLIC_URL=http://app.localhost           # https://app.chertiot.com in prod
PORTAL_PUBLIC_URL=http://localhost           # https://chertiot.com in prod
MQTT_HOST=localhost                          # what students connect to; chertiot.com in prod
MQTT_PORT=1883                               # 8883 (TLS via Caddy layer4) in staging/prod
# OIDC client secrets (one per client in the chertiot realm)
KC_SECRET_THINGSBOARD=change-me
KC_SECRET_PORTAL=change-me
KC_SECRET_JUPYTERHUB=change-me
KC_SECRET_GRAFANA=change-me
# Dev-only test user created by setup_keycloak.py when ENV=dev (never in staging/prod)
DEV_TEST_USER_EMAIL=student1@example.com
DEV_TEST_USER_PASSWORD=change-me
# ---- portal ----
PORTAL_SECRET_KEY=change-me
PORTAL_DATABASE_URL=postgresql+psycopg://chertiot:change-me@postgres:5432/portal
# ---- grafana ----
KUMA_ADMIN=chertiotadmin
KUMA_PASSWORD=change-me                       # Uptime Kuma admin (generated on deploy)
GRAFANA_ADMIN_PASSWORD=change-me
# ---- smtp (keycloak + portal email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@chertiot.com
SMTP_STARTTLS=true                            # false for the dev mailpit catcher
# ---- backups (M2.3): restic target + encryption password; pgBackRest config in deploy/pgbackrest/ ----
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
