# CHERT IoT — copy to .env and fill in. Never commit .env.
# ---- domain / routing ----
DOMAIN=chertiot.com
ENV=dev                      # dev | staging | prod
# ---- postgres ----
POSTGRES_VERSION=16
POSTGRES_USER=chertiot
POSTGRES_PASSWORD=change-me
# ---- thingsboard (pin at M0.2) ----
TB_VERSION=
TB_SYSADMIN_EMAIL=sysadmin@thingsboard.org
TB_SYSADMIN_PASSWORD=change-me
# ---- keycloak (pin at M0.2) ----
KEYCLOAK_VERSION=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# ---- portal ----
PORTAL_SECRET_KEY=change-me
PORTAL_DATABASE_URL=postgresql+psycopg://chertiot:change-me@postgres:5432/portal
# ---- smtp ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@chertiot.com
