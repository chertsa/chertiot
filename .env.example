# CHERT IoT — copy to .env and fill in. Never commit .env.
# ---- environment / routing ----
ENV=dev                          # dev | staging | prod
DOMAIN=localhost                 # chertiot.com in prod; staging.chertiot.com in staging
CADDYFILE=deploy/caddy/Caddyfile.dev   # deploy/caddy/Caddyfile.prod from M2.2
# ---- image pins (M0.2, 2026-08-30). Upgrades are deliberate milestones. ----
POSTGRES_VERSION=16.15
TB_VERSION=4.3.1.4
KEYCLOAK_VERSION=26.7.2
CADDY_VERSION=2.11.4
CADDY_IMAGE=caddy:2.11.4              # chertiot/caddy:2.11.4-l4 in staging/prod (make caddy-image)
CADDY_L4_VERSION=42db5690dea1
PROMETHEUS_VERSION=v3.14.0
GRAFANA_VERSION=13.1.4
UPTIME_KUMA_VERSION=2.5.3
NODE_EXPORTER_VERSION=v1.12.1
CADVISOR_VERSION=v0.55.1
POSTGRES_EXPORTER_VERSION=v0.20.1
# ---- postgres (superuser; owns databases thingsboard, keycloak, portal) ----
POSTGRES_USER=chertiot
POSTGRES_PASSWORD=change-me
# ---- thingsboard ----
TB_JAVA_OPTS="-Xms256m -Xmx1536m"
TB_SYSADMIN_EMAIL=sysadmin@thingsboard.org   # default; rotated by M0.4 bootstrap
TB_SYSADMIN_PASSWORD=sysadmin                # default; rotated by M0.4 bootstrap
# ---- keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KC_HOSTNAME=http://auth.localhost            # https://auth.chertiot.com in prod
KC_REALM=chertiot
KC_INTERNAL_URL=http://keycloak:8080         # backchannel (token/userinfo) from TB/portal containers
TB_PUBLIC_URL=http://app.localhost           # https://app.chertiot.com in prod
PORTAL_PUBLIC_URL=http://localhost           # https://chertiot.com in prod
# OIDC client secrets (one per client in the chertiot realm)
KC_SECRET_THINGSBOARD=change-me
KC_SECRET_PORTAL=change-me
KC_SECRET_JUPYTERHUB=change-me
KC_SECRET_GRAFANA=change-me
# Dev-only test user created by setup_keycloak.py when ENV=dev (never in staging/prod)
DEV_TEST_USER_EMAIL=student1@example.com
DEV_TEST_USER_PASSWORD=change-me
# ---- portal ----
PORTAL_SECRET_KEY=change-me
PORTAL_DATABASE_URL=postgresql+psycopg://chertiot:change-me@postgres:5432/portal
# ---- grafana ----
GRAFANA_ADMIN_PASSWORD=change-me
# ---- smtp (keycloak + portal email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@chertiot.com
