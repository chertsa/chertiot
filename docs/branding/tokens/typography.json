{
  "$meta": {
    "source": "branding/CHERT-Design-System.md v1.0 (§4, §7.4, §9 token contract)",
    "generated": "2026-08-14",
    "rule": "Fonts must be self-hosted/local in production — no remote font services (privacy + no-external-dependency policy)."
  },
  "families": {
    "font-ui":      { "stack": "'Inter', system-ui, -apple-system, sans-serif", "use": "Interface and body (EN) — everything." },
    "font-display": { "stack": "'Playfair Display', Georgia, serif", "use": "Marketing heroes ONLY, ≥40px, English only. Never in app UI or body text." },
    "font-ar":      { "stack": "'IBM Plex Sans Arabic', 'Cairo', sans-serif", "use": "All Arabic text, all roles. Playfair has no Arabic — Arabic hero uses IBM Plex Sans Arabic 700." },
    "font-mono":    { "stack": "'JetBrains Mono', 'Consolas', monospace", "use": "Code, IDs, metrics, tabular data." }
  },
  "scale": {
    "fs-display":  { "size": "56px", "weight": 700, "lineHeight": 1.05, "tracking": "-1.5px", "use": "Marketing hero (Playfair)", "mobile": "36px" },
    "fs-h1":       { "size": "40px", "weight": 800, "lineHeight": 1.1,  "tracking": "-1px",   "use": "Page title", "mobile": "30px" },
    "fs-h2":       { "size": "30px", "weight": 700, "lineHeight": 1.15, "tracking": "-0.5px", "use": "Section heading", "mobile": "24px" },
    "fs-h3":       { "size": "22px", "weight": 700, "lineHeight": 1.25, "tracking": "0",      "use": "Card title, subsection" },
    "fs-lg":       { "size": "18px", "weight": 400, "lineHeight": 1.5,  "tracking": "0",      "use": "Lead paragraph" },
    "fs-base":     { "size": "16px", "weight": 400, "lineHeight": 1.5,  "tracking": "0",      "use": "Body" },
    "fs-sm":       { "size": "14px", "weight": 500, "lineHeight": 1.45, "tracking": "0",      "use": "Captions, table cells, nav" },
    "fs-xs":       { "size": "13px", "weight": 500, "lineHeight": 1.4,  "tracking": "0",      "use": "Helper text, badges" },
    "fs-overline": { "size": "12px", "weight": 600, "lineHeight": 1.3,  "tracking": "3px",    "use": "Kickers (UPPERCASE, EN only)" }
  },
  "line-heights": { "lh-tight": 1.1, "lh-snug": 1.25, "lh-base": 1.5, "lh-ar": 1.7 },
  "arabic": {
    "font": "'IBM Plex Sans Arabic', 'Cairo', sans-serif",
    "bodySize": "17px (+1px vs English — Arabic reads optically smaller)",
    "lineHeight": 1.7,
    "letterSpacing": "normal — NEVER adjust; breaks letter joining",
    "italics": "NEVER — no true Arabic italic; use weight 700 for emphasis",
    "textTransform": "NEVER — Arabic has no letter case",
    "alignment": "start (= right in RTL)"
  },
  "rules": [
    "Body line length max 68ch (65–75 characters).",
    "Never letter-space lowercase body text — tracking is for overlines only.",
    "Only two weights per screen beyond body: 700 and 800.",
    "Bidi isolation required for numbers, dates, domains, emails, IDs, and code inside Arabic text (direction: ltr; unicode-bidi: isolate)."
  ]
}
