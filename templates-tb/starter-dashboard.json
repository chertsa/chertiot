{
  "title": "My devices",
  "configuration": {
    "description": "CHERT IoT starter dashboard. Shows every device in your tenant. Edit freely — 'Reset starter dashboard' in the portal restores this version.",
    "widgets": {
      "w-devices": {
        "id": "w-devices",
        "typeFullFqn": "system.cards.entities_table",
        "type": "latest",
        "sizeX": 24,
        "sizeY": 5,
        "config": {
          "title": "Devices",
          "showTitle": true,
          "dropShadow": true,
          "enableFullscreen": false,
          "datasources": [
            {
              "type": "entity",
              "name": "",
              "entityAliasId": "alias-all-devices",
              "dataKeys": [
                {"name": "name", "type": "entityField", "label": "Name", "color": "#FF8651", "settings": {}},
                {"name": "active", "type": "attribute", "label": "Active", "color": "#10B981", "settings": {}},
                {"name": "lastActivityTime", "type": "attribute", "label": "Last seen", "color": "#6B6B66", "settings": {}}
              ]
            }
          ],
          "settings": {"enableSearch": true, "enableSelectColumnDisplay": false, "displayEntityName": true, "entitiesTitle": "Devices", "displayPagination": true, "defaultPageSize": 10, "enableStickyHeader": true}
        }
      },
      "w-temperature": {
