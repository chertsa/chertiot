    "timewindow": {"displayValue": "", "selectedTab": 0, "realtime": {"realtimeType": 0, "timewindowMs": 3600000, "interval": 10000}, "aggregation": {"type": "NONE", "limit": 2000}},
    "settings": {"stateControllerId": "entity", "showTitle": false, "showDashboardsSelect": true, "showEntitiesSelect": true, "showDashboardTimewindow": true, "showDashboardExport": true, "toolbarAlwaysOpen": true}
