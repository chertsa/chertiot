              "entityAliasId": "alias-all-devices",
              "dataKeys": [
                {"name": "temperature", "type": "timeseries", "label": "temperature", "color": "#FF8651", "settings": {}, "units": "°C"}
              ]
            }
          ],
          "settings": {}
        }
      },
      "w-humidity": {
        "id": "w-humidity",
        "typeFullFqn": "system.time_series_chart",
        "type": "timeseries",
        "sizeX": 12,
        "sizeY": 7,
        "config": {
          "title": "Humidity",
          "showTitle": true,
          "dropShadow": true,
          "useDashboardTimewindow": true,
          "showLegend": true,
          "datasources": [
            {
              "type": "entity",
              "name": "",
              "entityAliasId": "alias-all-devices",
              "dataKeys": [
                {"name": "humidity", "type": "timeseries", "label": "humidity", "color": "#D2B082", "settings": {}, "units": "%"}
              ]
            }
          ],
          "settings": {}
        }
      },
      "w-latest": {
        "id": "w-latest",
        "typeFullFqn": "system.cards.timeseries_table",
        "type": "timeseries",
        "sizeX": 24,
        "sizeY": 6,
        "config": {
          "title": "Latest telemetry",
          "showTitle": true,
          "dropShadow": true,
          "useDashboardTimewindow": true,
          "datasources": [
            {
              "type": "entity",
              "name": "",
              "entityAliasId": "alias-all-devices",
              "dataKeys": [
                {"name": "temperature", "type": "timeseries", "label": "temperature", "color": "#FF8651", "settings": {}},
                {"name": "humidity", "type": "timeseries", "label": "humidity", "color": "#D2B082", "settings": {}}
              ]
            }
          ],
          "settings": {"showTimestamp": true, "displayPagination": true, "defaultPageSize": 10}
