msgstr "تعذّر إعداد مختبرك:"

#: app/templates/home.html:67
msgid "Setting up your lab…"
msgstr "جارٍ إعداد مختبرك…"

#: app/templates/home.html:68
msgid "Set up now"
msgstr "الإعداد الآن"

#: app/templates/home_panel.html:8 app/templates/home_panel.html:34
#: app/templates/teach/roster.html:7
msgid "Devices"
msgstr "الأجهزة"

#: app/templates/home_panel.html:12
msgid "Online now"
