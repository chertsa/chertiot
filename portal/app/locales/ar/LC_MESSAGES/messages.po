msgid "Stop my instance"
msgstr "إيقاف نسختي"

#: app/templates/flows.html:13
msgid "Instances stop automatically after 30 minutes without use; your flows are kept."
msgstr "تتوقف النسخ تلقائيًا بعد 30 دقيقة دون استخدام؛ تدفقاتك محفوظة."

#: app/templates/flows.html:15
