#: app/main.py:154
msgid "The lab is busy right now"
msgstr "المختبر مشغول حاليًا"

#: app/main.py:156
msgid "A backend service did not answer in time. Nothing was lost — wait a minute and try again."
msgstr "لم تستجب إحدى الخدمات في الوقت المناسب. لم يُفقد شيء — انتظر دقيقة وحاول مجددًا."

#: app/site_content.py:29
msgid "Devices & sensing"
msgstr "الأجهزة والاستشعار"

#: app/site_content.py:30
msgid "Sensors and microcontrollers that measure the physical world."
msgstr "مستشعرات ومتحكّمات دقيقة تقيس العالم المادي."

#: app/site_content.py:32
msgid "Wi-Fi microcontroller"
msgstr "متحكّم دقيق بـ Wi-Fi"

#: app/site_content.py:33
msgid "Linux single-board computer"
msgstr "حاسوب Linux أحادي اللوحة"

#: app/site_content.py:34
msgid "Browser device"
msgstr "جهاز المتصفّح"

#: app/site_content.py:34
msgid "No hardware needed"
msgstr "لا حاجة إلى عتاد"

#: app/site_content.py:35
msgid "LoRa sensors"
msgstr "مستشعرات LoRa"

#: app/site_content.py:35
msgid "Long-range, low-power"
msgstr "مدى بعيد، طاقة منخفضة"

#: app/site_content.py:42
msgid "Connectivity & edge"
msgstr "الاتصال والحافة"

#: app/site_content.py:43
msgid "Secure transport from the field into the platform."
msgstr "نقل آمن من الميدان إلى المنصّة."

#: app/site_content.py:45
msgid "TLS edge · MQTTS :8883"
msgstr "حافة TLS · MQTTS :8883"

#: app/site_content.py:46
msgid "LoRa gateway"
msgstr "بوابة LoRa"

#: app/site_content.py:46
msgid "Your radio gateway"
msgstr "بوابتك اللاسلكية"

#: app/site_content.py:47
msgid "Gateway Bridge"
msgstr "جسر البوابة"

#: app/site_content.py:47
msgid "ChirpStack UDP → MQTT"
msgstr "ChirpStack UDP → MQTT"

#: app/site_content.py:48
msgid "Internal LoRa broker"
msgstr "وسيط LoRa داخلي"

#: app/site_content.py:49
msgid "LoRaWAN network server"
msgstr "خادم شبكة LoRaWAN"

#: app/site_content.py:50
msgid "LoRa uplinks → ThingsBoard"
msgstr "إرسالات LoRa → ThingsBoard"

#: app/site_content.py:57
msgid "Platform & data"
msgstr "المنصّة والبيانات"

#: app/site_content.py:58
msgid "Device registry, rule engine, alarms and durable storage."
msgstr "سجل الأجهزة ومحرّك القواعد والتنبيهات والتخزين الدائم."

#: app/site_content.py:60
msgid "Devices · rules · alarms"
msgstr "أجهزة · قواعد · تنبيهات"

#: app/site_content.py:61
msgid "Telemetry & state"
msgstr "القياسات والحالة"

#: app/site_content.py:62
msgid "LoRaWAN session cache"
msgstr "ذاكرة جلسات LoRaWAN"

#: app/site_content.py:69
msgid "Applications & insight"
msgstr "التطبيقات والرؤى"

#: app/site_content.py:70
msgid "Where people see, automate and analyse their data."
msgstr "حيث يرى الناس بياناتهم ويؤتمتونها ويحلّلونها."

#: app/site_content.py:72
msgid "CHERT portal"
msgstr "بوابة CHERT"

#: app/site_content.py:72
msgid "Projects · devices · monitoring"
msgstr "مشاريع · أجهزة · مراقبة"

#: app/site_content.py:73
msgid "Dashboards"
msgstr "اللوحات"

#: app/site_content.py:73
msgid "Live widgets & reports"
msgstr "عناصر حيّة وتقارير"

#: app/site_content.py:74
msgid "No-code automation"
msgstr "أتمتة دون برمجة"

#: app/site_content.py:75
msgid "Python notebooks"
msgstr "دفاتر Python"

#: app/site_content.py:76 app/templates/base.html:30 app/templates/base.html:42
#: app/templates/base.html:58 app/templates/explore.html:49 app/templates/index.html:30
#: app/templates/index.html:257
msgid "Docs"
msgstr "الوثائق"

#: app/site_content.py:76
msgid "Guides & firmware"
msgstr "أدلة وبرامج ثابتة"

#: app/site_content.py:83
msgid "Security & identity"
msgstr "الأمان والهوية"

#: app/site_content.py:84
msgid "One identity, isolated projects."
msgstr "هوية واحدة، ومشاريع معزولة."

#: app/site_content.py:86 app/site_content.py:386
msgid "Single sign-on"
msgstr "تسجيل الدخول الموحّد"

#: app/site_content.py:87
msgid "Project isolation"
msgstr "عزل المشاريع"

#: app/site_content.py:87
msgid "One tenant per project"
msgstr "مستأجر لكل مشروع"

#: app/site_content.py:88
msgid "Per-user sandbox"
msgstr "بيئة معزولة لكل مستخدم"

#: app/site_content.py:88
msgid "Capped containers"
msgstr "حاويات محدودة الموارد"

#: app/site_content.py:95
msgid "Operations & observability"
msgstr "التشغيل والمراقبة"

#: app/site_content.py:96
msgid "Keeping the platform healthy."
msgstr "الحفاظ على سلامة المنصّة."

#: app/site_content.py:98
msgid "Metrics collection"
msgstr "جمع المقاييس"

#: app/site_content.py:99
msgid "Platform monitor"
msgstr "مراقب المنصّة"

#: app/site_content.py:100
msgid "Operator alerts"
msgstr "تنبيهات المشغّلين"

#: app/site_content.py:101
msgid "Public status page"
msgstr "صفحة الحالة العامة"

#: app/site_content.py:111
msgid ""
"The classic IoT board. CHERT generates ready-to-flash starter firmware with your device's access "
"token and the broker address already filled in."
msgstr ""
"اللوحة الكلاسيكية لإنترنت الأشياء. تولّد CHERT برنامجًا ثابتًا أوليًّا جاهزًا للرفع، فيه رمز وصول"
" جهازك وعنوان الوسيط مُعبّآن مسبقًا."

#: app/site_content.py:115
msgid ""
"A full Linux computer at the edge. Starter Python code publishes readings over MQTT or HTTP — "
"ideal for gateways, cameras and heavier sensors."
msgstr ""
"حاسوب Linux كامل عند الطرف. ينشر كود Python الأولي القراءات عبر MQTT أو HTTP — مثالي للبوابات "
"والكاميرات والمستشعرات الأثقل."

#: app/site_content.py:119
msgid ""
"No hardware yet? A browser page acts as a virtual device and sends real telemetry, so you can "
"build dashboards and rules on day one."
msgstr ""
"لا عتاد بعد؟ تعمل صفحة في المتصفّح جهازًا افتراضيًّا يرسل قياسات حقيقية، فتبني اللوحات والقواعد "
"من اليوم الأول."

#: app/site_content.py:123
msgid ""
"Battery-powered sensors that reach kilometres over LoRaWAN, for agriculture, metering and "
"environmental monitoring."
msgstr "مستشعرات تعمل بالبطارية تصل إلى كيلومترات عبر LoRaWAN، للزراعة والعدّادات والرصد البيئي."

#: app/site_content.py:127
msgid ""
"The single front door. It serves every site over HTTPS with automatic certificates and terminates"
" MQTTS on port 8883 before handing messages to ThingsBoard."
msgstr ""
"البوابة الأمامية الوحيدة. يقدّم كل موقع عبر HTTPS بشهادات تلقائية، وينهي MQTTS على المنفذ 8883 "
"قبل تسليم الرسائل إلى ThingsBoard."

#: app/site_content.py:131
msgid ""
"A LoRaWAN gateway receives radio uplinks from nearby sensors and forwards them over the internet "
"to the platform."
msgstr "تستقبل بوابة LoRaWAN الإرسالات اللاسلكية من المستشعرات القريبة وتمرّرها عبر الإنترنت إلى المنصّة."

#: app/site_content.py:135
msgid ""
"ChirpStack Gateway Bridge converts the gateway's packet-forwarder protocol into MQTT messages the"
" network server understands."
msgstr "يحوّل ChirpStack Gateway Bridge بروتوكول تمرير الحزم في البوابة إلى رسائل MQTT يفهمها خادم الشبكة."

#: app/site_content.py:139
msgid ""
"An internal MQTT broker that carries LoRaWAN traffic between the gateway bridge, ChirpStack and "
"lora-bridge. It is never exposed to the internet."
msgstr ""
"وسيط MQTT داخلي ينقل حركة LoRaWAN بين جسر البوابة وChirpStack وlora-bridge، ولا يُعرَّض للإنترنت "
"أبدًا."

#: app/site_content.py:143
msgid ""
"The LoRaWAN network server: device activation, de-duplication, decryption and decoding of uplink "
"payloads."
msgstr "خادم شبكة LoRaWAN: تفعيل الأجهزة وإزالة التكرار وفك التشفير وتفسير حمولات الإرسال."

#: app/site_content.py:147
msgid ""
"A small CHERT service that subscribes to ChirpStack's decoded uplinks and delivers them to the "
"right device in the right project on ThingsBoard."
msgstr ""
"خدمة صغيرة من CHERT تشترك في الإرسالات المفكوكة من ChirpStack وتسلّمها إلى الجهاز الصحيح في "
"المشروع الصحيح على ThingsBoard."

#: app/site_content.py:151
msgid ""
"The IoT core. Each CHERT project is its own ThingsBoard tenant with its own devices, rule chains,"
" alarms and dashboards — nothing is shared between projects."
msgstr ""
"قلب إنترنت الأشياء. كل مشروع في CHERT مستأجر مستقل على ThingsBoard بأجهزته وسلاسل قواعده "
"وتنبيهاته ولوحاته — لا شيء مشترك بين المشاريع."

#: app/site_content.py:155
msgid ""
"Every reading, attribute, alarm and project record is stored durably in PostgreSQL on your own "
"server."
msgstr "تُخزَّن كل قراءة وخاصية وتنبيه وسجل مشروع بشكل دائم في PostgreSQL على خادمك."

#: app/site_content.py:158
msgid "Fast in-memory state that ChirpStack uses for LoRaWAN device sessions."
msgstr "حالة سريعة في الذاكرة يستخدمها ChirpStack لجلسات أجهزة LoRaWAN."

#: app/site_content.py:160
msgid ""
"Your home base: create projects, invite your team, register devices, copy starter code, watch "
"live monitoring and print lifecycle reports."
msgstr ""
"قاعدتك الرئيسية: أنشئ المشاريع، وادعُ فريقك، وسجّل الأجهزة، وانسخ الكود الأولي، وتابع المراقبة "
"الحيّة، واطبع تقارير دورة الحياة."

#: app/site_content.py:164
msgid ""
"Every project starts with a ready dashboard. Add charts, gauges, maps and tables that update in "
"real time as readings arrive."
msgstr "يبدأ كل مشروع بلوحة جاهزة. أضِف رسومًا ومقاييس وخرائط وجداول تتحدّث لحظيًّا مع وصول القراءات."

#: app/site_content.py:168
msgid ""
"A personal Node-RED editor per project, already connected to ThingsBoard. Wire devices to logic, "
"notifications and webhooks without writing code."
msgstr ""
"محرّر Node-RED شخصي لكل مشروع، متصل مسبقًا بـ ThingsBoard. اربط الأجهزة بالمنطق والإشعارات "
"وwebhooks دون كتابة كود."

#: app/site_content.py:172
msgid ""
"A JupyterLab server per project with pandas and matplotlib, scoped to your own telemetry — for "
"cleaning, analysing and modelling your data."
msgstr ""
"خادم JupyterLab لكل مشروع مع pandas وmatplotlib، ضمن نطاق قياساتك وحدها — لتنظيف بياناتك وتحليلها"
" ونمذجتها."

#: app/site_content.py:176
msgid ""
"Step-by-step guides in English and Arabic, from flashing your first board to building rule chains"
" and notebooks."
msgstr "أدلة خطوة بخطوة بالعربية والإنجليزية، من برمجة أول لوحة إلى بناء سلاسل القواعد والدفاتر."

#: app/site_content.py:180
msgid ""
"One CHERT account signs you in to the portal, ThingsBoard, Node-RED and JupyterLab. Email "
"verification and sessions are handled centrally."
msgstr ""
"حساب CHERT واحد يُدخلك إلى البوابة وThingsBoard وNode-RED وJupyterLab. يُدار التحقق من البريد "
"والجلسات مركزيًّا."

#: app/site_content.py:184
msgid ""
"A project is an isolated tenant. Members see only the projects they belong to, and destructive "
"actions stay with the owner."
msgstr ""
"المشروع مستأجر معزول. لا يرى الأعضاء إلا المشاريع التي ينتمون إليها، وتبقى الإجراءات المدمِّرة "
"بيد المالك."

#: app/site_content.py:188
msgid ""
"Node-RED and notebook servers run as separate containers per user, with capped CPU and memory so "
"one experiment can't affect anyone else."
msgstr ""
"تعمل خوادم Node-RED والدفاتر في حاويات منفصلة لكل مستخدم، بمعالج وذاكرة محدودين كي لا تؤثر تجربة "
"على غيرها."

#: app/site_content.py:192
msgid "Scrapes health metrics from every server, container and database on the platform."
msgstr "يجمع مقاييس السلامة من كل خادم وحاوية وقاعدة بيانات في المنصّة."

#: app/site_content.py:195
msgid ""
"The platform monitor for instructors and administrators: device traffic, resource use and service"
" health at a glance."
msgstr "مراقب المنصّة للمدرّبين والمسؤولين: حركة الأجهزة واستهلاك الموارد وسلامة الخدمات بنظرة واحدة."

#: app/site_content.py:199
msgid "Routes operator alerts when something on the platform needs attention — before users notice."
msgstr "يوجّه تنبيهات المشغّلين عندما يحتاج شيء في المنصّة إلى انتباه — قبل أن يلاحظه المستخدمون."

#: app/site_content.py:202
msgid "A public status page with live up/down checks for every public service."
msgstr "صفحة حالة عامة بفحوص حيّة للتشغيل والتوقف لكل خدمة عامة."

#: app/site_content.py:211
msgid "Plan"
msgstr "التخطيط"

#: app/site_content.py:212
msgid "Define the goal and the team"
msgstr "حدِّد الهدف والفريق"

#: app/site_content.py:214
msgid "Decide what to measure and why. Create a project in CHERT, invite members and agree who owns it."
msgstr "حدّد ما ستقيسه ولماذا. أنشئ مشروعًا في CHERT، وادعُ الأعضاء، واتفقوا على مالكه."

#: app/site_content.py:221
msgid "Provision"
msgstr "التجهيز"

#: app/site_content.py:222
msgid "Get an isolated workspace"
msgstr "احصل على مساحة عمل معزولة"

#: app/site_content.py:224
msgid ""
"Creating a project provisions its own ThingsBoard tenant, a starter dashboard and a secure place "
"for its data — in seconds."
msgstr ""
"إنشاء مشروع يجهّز له مستأجرًا خاصًّا على ThingsBoard ولوحة بداية ومكانًا آمنًا لبياناته — في "
"ثوانٍ."

#: app/site_content.py:231
msgid "Build devices"
msgstr "بناء الأجهزة"

#: app/site_content.py:232
msgid "Wire sensors and flash firmware"
msgstr "وصِّل المستشعرات وارفع البرنامج الثابت"

#: app/site_content.py:234
msgid ""
"Register each device to get its access token, then flash ready-made starter code onto an ESP32, a"
" Raspberry Pi or a browser device."
msgstr ""
"سجّل كل جهاز لتحصل على رمز وصوله، ثم ارفع كودًا أوليًّا جاهزًا إلى ESP32 أو Raspberry Pi أو جهاز "
"متصفّح."

#: app/site_content.py:241
msgid "Connect"
msgstr "الاتصال"

#: app/site_content.py:242
msgid "Transmit securely"
msgstr "أرسِل بأمان"

#: app/site_content.py:244
msgid ""
"Devices publish over MQTTS, HTTPS or LoRaWAN. Traffic is encrypted end to end and authenticated "
"per device."
msgstr "تنشر الأجهزة عبر MQTTS أو HTTPS أو LoRaWAN. الحركة مشفّرة من طرف إلى طرف وموثَّقة لكل جهاز."

#: app/site_content.py:251
msgid "Ingest & store"
msgstr "الاستقبال والتخزين"

#: app/site_content.py:252
msgid "Process every reading"
msgstr "عالِج كل قراءة"

#: app/site_content.py:254
msgid ""
"The rule engine validates, enriches and routes each message, then stores it as time-series data "
"you can query later."
msgstr "يتحقق محرّك القواعد من كل رسالة ويُثريها ويوجّهها، ثم يخزّنها بيانات زمنية تستعلم عنها لاحقًا."

#: app/site_content.py:261
msgid "Visualise"
msgstr "العرض المرئي"

#: app/site_content.py:262
msgid "See what is happening"
msgstr "شاهد ما يحدث"

#: app/site_content.py:264
msgid "Live dashboards, per-device monitoring with last-seen status, and 24-hour trends in the portal."
msgstr "لوحات حيّة، ومراقبة لكل جهاز مع آخر ظهور، واتجاهات ٢٤ ساعة في البوابة."

#: app/site_content.py:271
msgid "Automate & alert"
msgstr "الأتمتة والتنبيه"

#: app/site_content.py:272
msgid "React automatically"
msgstr "تفاعل تلقائيًّا"

#: app/site_content.py:274
msgid ""
"Set thresholds that raise alarms, then send emails, call webhooks or trigger actions with Node-"
"RED flows."
msgstr ""
"حدّد عتبات تُطلق التنبيهات، ثم أرسل رسائل بريد أو استدعِ webhooks أو شغّل إجراءات بتدفّقات Node-"
"RED."

#: app/site_content.py:281
msgid "Analyse"
msgstr "التحليل"

#: app/site_content.py:282
msgid "Turn data into insight"
msgstr "حوِّل البيانات إلى رؤى"

#: app/site_content.py:284
msgid ""
"Pull your history into a JupyterLab notebook, clean it with pandas, chart it with matplotlib and "
"share findings."
msgstr "اسحب سجلّك إلى دفتر JupyterLab، ونظّفه بـ pandas، وارسمه بـ matplotlib، وشارك النتائج."

#: app/site_content.py:291
msgid "Operate & evolve"
msgstr "التشغيل والتطوير"

#: app/site_content.py:292
msgid "Keep it running, then improve"
msgstr "حافظ على التشغيل، ثم طوِّر"

#: app/site_content.py:294
msgid ""
"Watch platform health, rotate device tokens, print lifecycle reports and feed what you learned "
"into the next iteration."
msgstr ""
"راقب سلامة المنصّة، وجدّد رموز الأجهزة، واطبع تقارير دورة الحياة، وانقل ما تعلّمته إلى الدورة "
"التالية."

#: app/site_content.py:352
msgid "Follow a reading"
msgstr "تتبّع قراءة"

#: app/site_content.py:354
msgid "An ESP32 reads its temperature sensor and publishes JSON over MQTT."
msgstr "يقرأ ESP32 مستشعر الحرارة وينشر JSON عبر MQTT."

#: app/site_content.py:355
msgid "Caddy accepts the encrypted MQTTS connection on port 8883."
msgstr "يستقبل Caddy اتصال MQTTS المشفّر على المنفذ 8883."

#: app/site_content.py:358
msgid "ThingsBoard checks the device token and runs your project's rule chain."
msgstr "يتحقق ThingsBoard من رمز الجهاز ويشغّل سلسلة قواعد مشروعك."

#: app/site_content.py:360
msgid "The reading is stored as time-series in PostgreSQL."
msgstr "تُخزَّن القراءة سلسلةً زمنية في PostgreSQL."

#: app/site_content.py:361
msgid "Your dashboard widgets update within a second."
msgstr "تتحدّث عناصر لوحتك خلال ثانية."

#: app/site_content.py:362
msgid "The portal's Monitoring view shows last-seen and 24-hour trends."
msgstr "تعرض شاشة المراقبة في البوابة آخر ظهور واتجاهات ٢٤ ساعة."

#: app/site_content.py:363
msgid "A Node-RED flow reacts — for example, sending a notification."
msgstr "يتفاعل تدفّق Node-RED — مثلًا بإرسال إشعار."

#: app/site_content.py:364
msgid "Later, a notebook loads the history into pandas for analysis."
msgstr "لاحقًا، يحمّل دفتر السجلَّ إلى pandas للتحليل."

#: app/site_content.py:369
msgid "LoRaWAN uplink"
msgstr "إرسال LoRaWAN"

#: app/site_content.py:371
msgid "A battery sensor wakes up and transmits a LoRa radio packet."
msgstr "يستيقظ مستشعر يعمل بالبطارية ويرسل حزمة LoRa لاسلكية."

#: app/site_content.py:372
msgid "Your gateway receives it, kilometres away, and forwards it."
msgstr "تستقبلها بوابتك على بُعد كيلومترات وتمرّرها."

#: app/site_content.py:373
msgid "The Gateway Bridge turns the packet into an MQTT message."
msgstr "يحوّل جسر البوابة الحزمة إلى رسالة MQTT."

#: app/site_content.py:374
msgid "The internal Mosquitto broker carries it inside the platform."
msgstr "ينقلها وسيط Mosquitto الداخلي داخل المنصّة."

#: app/site_content.py:375
msgid "ChirpStack de-duplicates, decrypts and decodes the payload."
msgstr "يزيل ChirpStack التكرار ويفك التشفير ويفسّر الحمولة."

#: app/site_content.py:378
msgid "lora-bridge delivers it to the matching device in your project."
msgstr "يسلّمها lora-bridge إلى الجهاز المطابق في مشروعك."

#: app/site_content.py:380
msgid "ThingsBoard treats it like any other reading."
msgstr "يعاملها ThingsBoard كأي قراءة أخرى."

#: app/site_content.py:381
msgid "It appears on the same dashboard as your Wi-Fi devices."
msgstr "تظهر على اللوحة نفسها مع أجهزة Wi-Fi لديك."

#: app/site_content.py:388
msgid "You open CHERT and choose Sign in."
msgstr "تفتح CHERT وتختار تسجيل الدخول."

#: app/site_content.py:389
msgid "Keycloak verifies your identity once, for every tool."
msgstr "يتحقق Keycloak من هويتك مرة واحدة، لكل الأدوات."

#: app/site_content.py:390
msgid "The portal checks which projects you belong to and your role."
msgstr "تتحقق البوابة من المشاريع التي تنتمي إليها ومن دورك."

#: app/site_content.py:391
msgid "ThingsBoard opens with a session limited to that project."
msgstr "يُفتح ThingsBoard بجلسة مقصورة على ذلك المشروع."

#: app/site_content.py:392
msgid "Your own Node-RED and notebook containers start on demand."
msgstr "تبدأ حاويات Node-RED والدفاتر الخاصة بك عند الطلب."

#: app/site_content.py:393
msgid "JupyterLab opens through the same identity — no extra password."
msgstr "يُفتح JupyterLab بالهوية نفسها — دون كلمة مرور إضافية."

#: app/site_content.py:398
msgid "Platform health"
msgstr "سلامة المنصّة"

#: app/site_content.py:402
msgid "Prometheus scrapes metrics from every service every few seconds."
msgstr "يجمع Prometheus المقاييس من كل خدمة كل بضع ثوانٍ."

#: app/site_content.py:404
msgid "Grafana turns them into the live platform monitor."
msgstr "يحوّلها Grafana إلى مراقِب حيّ للمنصّة."

#: app/site_content.py:405
msgid "If a threshold is crossed, Alertmanager notifies operators."
msgstr "إذا تجاوزت قيمةٌ الحدّ، يُبلغ Alertmanager المشغّلين."

#: app/site_content.py:406
msgid "The public status page shows everyone what is up."
msgstr "تُظهر صفحة الحالة العامة للجميع ما يعمل."

