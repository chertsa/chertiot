#: app/main.py:55
msgid "The lab is busy right now"
msgstr "المختبر مشغول حاليًا"

#: app/main.py:57
msgid "A backend service did not answer in time. Nothing was lost — wait a minute and try again."
msgstr "لم تستجب إحدى الخدمات في الوقت المناسب. لم يُفقد شيء — انتظر دقيقة وحاول مجددًا."

#: app/routers/signup.py:57
msgid "Enter a valid email address."
msgstr "أدخل بريدًا إلكترونيًا صحيحًا."

#: app/routers/signup.py:59
msgid "Use at least 10 characters."
msgstr "استخدم عشرة أحرف على الأقل."

#: app/routers/signup.py:61
msgid "Passwords do not match."
msgstr "كلمتا المرور غير متطابقتين."

#: app/routers/signup.py:74
msgid "An account with this email exists. Sign in instead."
msgstr "يوجد حساب بهذا البريد. سجّل الدخول بدلًا من ذلك."

